SUPABASE_SERVICE_ROLE_KEY=

# Payload
PAYLOAD_SECRET=

# Email and newsletter
RESEND_API_KEY=
MAILERLITE_API_KEY=

# Bot protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Internal endpoints
REVALIDATE_SECRET=
CRON_SECRET=

# Public, domain-restricted
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_BUYINGBUDDY_KEY=

# WordPress export (milestone 5)
WP_APP_USER=
WP_APP_PASSWORD=
