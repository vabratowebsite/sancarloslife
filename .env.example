# Copy to .env.local and fill in. Never commit real values.
# Production and Preview values live in Vercel project settings.

# Supabase (Civic Watch / ops desk project). Pooled connection string.
DATABASE_URL=
# Migration scripts only, run from a laptop. Never used by the app.
SUPABASE_SERVICE_ROLE_KEY=

# Payload
PAYLOAD_SECRET=
# Local development only: let Payload create/alter tables directly. Never true against Supabase.
PAYLOAD_DB_PUSH=
NEXT_PUBLIC_SITE_URL=

# Supabase Storage (S3-compatible) for media. Leave empty locally to store uploads on disk.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email (Resend). Without a key, emails are written to the server log.
RESEND_API_KEY=
EMAIL_FROM="San Carlos Life <hello@sancarloslife.com>"
# Who gets form notifications (comma-separated)
FORMS_NOTIFY_TO=hello@sancarloslife.com
# Links emailed to people who request a guide (PDFs in Supabase Storage)
GUIDE_BUYER_URL=
GUIDE_SELLER_URL=

# Newsletter (MailerLite). Without a key, sign-ups are acknowledged but not sent.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_NEWSLETTER=
MAILERLITE_GROUP_EVENTS=
MAILERLITE_GROUP_REAL_ESTATE=
MAILERLITE_GROUP_GUIDES=

# Bot protection (Cloudflare Turnstile). Development uses Cloudflare's test keys when empty;
# production refuses form submissions until TURNSTILE_SECRET_KEY is set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Internal endpoints
REVALIDATE_SECRET=
CRON_SECRET=

# Public, domain-restricted
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_BUYINGBUDDY_KEY=

# WordPress export (milestone 5)
WP_APP_USER=
WP_APP_PASSWORD=

# Search engines: leave empty until cutover, then set to true on production only.
ALLOW_INDEXING=

# Buying Buddy CRM: address that turns emails into leads (ask Buying Buddy support). Empty = leads are stored and emailed only.
BUYINGBUDDY_LEAD_EMAIL=
